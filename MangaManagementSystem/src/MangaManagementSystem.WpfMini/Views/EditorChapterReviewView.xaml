<UserControl x:Class="MangaManagementSystem.WpfMini.Views.EditorChapterReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════════════════ -->
        <!-- LEFT: Queue Panel (Master)                          -->
        <!-- ════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="Chapter Review Queue" FontSize="18" FontWeight="Bold"
                       Foreground="#2c3e50"/>

            <!-- KPI row -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,6">
                <Border Background="#ebf5fb" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                    <TextBlock FontSize="11" Foreground="#2980b9">
                        <Run Text="Under Review:" FontWeight="Bold"/>
                        <Run Text="{Binding UnderReviewCount}"/>
                    </TextBlock>
                </Border>
                <Border Background="#eafaf1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                    <TextBlock FontSize="11" Foreground="#27ae60">
                        <Run Text="Approved:" FontWeight="Bold"/>
                        <Run Text="{Binding ApprovedThisWeekCount}"/>
                    </TextBlock>
                </Border>
                <Border Background="#fef5e7" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                    <TextBlock FontSize="11" Foreground="#e67e22">
                        <Run Text="Revision:" FontWeight="Bold"/>
                        <Run Text="{Binding RevisionRequestedCount}"/>
                    </TextBlock>
                </Border>
                <Border Background="#f4ecf7" CornerRadius="4" Padding="8,3">
                    <TextBlock FontSize="11" Foreground="#8e44ad">
                        <Run Text="On Hold:" FontWeight="Bold"/>
                        <Run Text="{Binding OnHoldCount}"/>
                    </TextBlock>
                </Border>
            </StackPanel>

            <!-- Status Filter + Refresh -->
            <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="8"
                    Margin="0,0,0,8" BorderBrush="#ddd" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Foreground="#666"
                               FontSize="12" Margin="0,0,8,0"/>
                    <ComboBox SelectedValue="{Binding StatusFilter}"
                              MinWidth="140" FontSize="13">
                        <ComboBoxItem Content="All Reviewable" IsSelected="True"/>
                        <ComboBoxItem Content="Under Review"/>
                        <ComboBoxItem Content="Revision Requested"/>
                        <ComboBoxItem Content="On Hold"/>
                        <ComboBoxItem Content="Approved"/>
                    </ComboBox>
                    <Button Content="⟳" Command="{Binding LoadQueueCommand}"
                            Background="#3498db" Foreground="White"
                            BorderThickness="0" Padding="8,4" Margin="8,0,0,0"
                            FontSize="16" ToolTip="Refresh"/>
                </StackPanel>
            </Border>

            <!-- Loading -->
            <TextBlock Grid.Row="3" Text="Loading queue..."
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#999"
                       Visibility="{Binding IsQueueLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Error -->
            <TextBlock Grid.Row="3" Text="{Binding QueueErrorMessage}" Foreground="#e74c3c"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       Visibility="{Binding QueueErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Queue List -->
            <ListBox Grid.Row="3" ItemsSource="{Binding ChapterQueue}"
                     SelectedItem="{Binding SelectedChapter}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsQueueLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}">
                <ListBox.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Border" Background="{TemplateBinding Background}"
                                            CornerRadius="6" Padding="0" BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#d5e8f7"/>
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#3498db"/>
                                            <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#ebf5fb"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Resources>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="6" Padding="12"
                                BorderBrush="#eee" BorderThickness="1">
                            <StackPanel>
                                <!-- Status Badge -->
                                <Border Background="{Binding StatusCode, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding StatusDisplay}" Foreground="White"
                                               FontSize="10" FontWeight="Bold"/>
                                </Border>

                                <!-- Series + Chapter -->
                                <TextBlock Text="{Binding SeriesTitle}" FontWeight="Bold"
                                           FontSize="14" Foreground="#2c3e50"/>
                                <TextBlock Text="{Binding DisplayTitle}" FontSize="12"
                                           Foreground="#555" Margin="0,2,0,0"/>

                                <!-- Meta -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock FontSize="11" Foreground="#95a5a6">
                                        <Run Text="{Binding PageCount}"/>
                                        <Run Text=" pages"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CreatedAtDisplay, StringFormat=' · {0}'}"
                                               FontSize="11" Foreground="#95a5a6" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ═══ Divider ═══ -->
        <Rectangle Grid.Column="1" Width="1" Fill="#ddd" Margin="0,10"/>

        <!-- ════════════════════════════════════════════════════ -->
        <!-- RIGHT: Detail + Actions Panel (Detail)              -->
        <!-- ════════════════════════════════════════════════════ -->
        <Grid Grid.Column="2" Margin="10">
            <!-- Empty state -->
            <TextBlock Text="Select a chapter from the queue to review"
                       Foreground="#95a5a6" FontSize="16" FontStyle="Italic"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}"/>

            <!-- Loading -->
            <TextBlock Text="Loading detail..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#999"
                       Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Detail Content -->
            <ScrollViewer Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Margin="0,0,12,12">

                    <!-- ═══ Chapter Info Card ═══ -->
                    <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                            BorderBrush="#e0e0e0" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedDetail.SeriesTitle}" FontSize="22"
                                           FontWeight="Bold" Foreground="#2c3e50"/>
                                <Border Background="{Binding SelectedDetail.StatusCode, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="4" Padding="8,3" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedDetail.StatusDisplay}" Foreground="White"
                                               FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedDetail.DisplayTitle}"
                                       FontSize="16" Foreground="#555" Margin="0,4,0,0"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Submitted by:" FontSize="12" Foreground="#888"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDetail.SubmittedByDisplayName}"
                                           FontSize="12" Foreground="#333" Margin="4,0,20,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Date:" FontSize="12" Foreground="#888"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedDetail.CreatedAtDisplay}"
                                           FontSize="12" Foreground="#333" Margin="4,0,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Pages:" FontSize="12" Foreground="#888" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="#333" Margin="4,6,0,0">
                                    <Run Text="{Binding SelectedDetail.PageCount}"/>
                                    <Run Text=" pages ("/>
                                    <Run Text="{Binding SelectedDetail.CurrentVersionCount}"/>
                                    <Run Text=" with images)"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══ Pages with Images ═══ -->
                    <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                            BorderBrush="#e0e0e0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Pages" FontSize="14" FontWeight="Bold"
                                       Foreground="#2c3e50" Margin="0,0,0,8"/>

                            <!-- Page thumbnails row -->
                            <ItemsControl ItemsSource="{Binding SelectedDetail.Pages}" MaxHeight="200">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#f5f5f5" CornerRadius="4" Padding="6"
                                                Margin="0,0,6,6" BorderBrush="#ddd" BorderThickness="1"
                                                Cursor="Hand" MinWidth="60" MinHeight="40">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                       FontSize="11" Foreground="#555"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Selected page image preview -->
                            <Border Background="#f9f9f9" CornerRadius="6" Padding="12" Margin="0,8,0,0"
                                    BorderBrush="#eee" BorderThickness="1"
                                    Visibility="{Binding SelectedPageImageUrl, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Page Preview" FontSize="12" FontWeight="Bold"
                                               Foreground="#555" Margin="0,0,0,6"/>
                                    <Image Source="{Binding SelectedPageImageUrl}" MaxHeight="300"
                                           Stretch="Uniform"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ═══ Annotations ═══ -->
                    <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                            BorderBrush="#e0e0e0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Open Annotations" FontSize="14" FontWeight="Bold"
                                       Foreground="#2c3e50" Margin="0,0,0,8"/>

                            <ItemsControl ItemsSource="{Binding SelectedDetail.OpenAnnotations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#fff8e1" CornerRadius="6" Padding="10"
                                                BorderBrush="#ffe082" BorderThickness="1" Margin="0,0,0,6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding IssueTypeCode}" FontWeight="Bold"
                                                               FontSize="11" Foreground="#e67e22"/>
                                                    <TextBlock Text="{Binding CreatedAtDisplay, StringFormat=' · {0}'}"
                                                               FontSize="11" Foreground="#888" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Comment}" TextWrapping="Wrap"
                                                           FontSize="12" Foreground="#856404" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding CreatedByDisplayName, StringFormat='by {0}'}"
                                                           FontSize="11" Foreground="#888" Margin="0,2,0,0"
                                                           FontStyle="Italic"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No open annotations" Foreground="#95a5a6" FontSize="12"
                                       FontStyle="Italic"
                                       Visibility="{Binding HasAnnotations, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ Actions ═══ -->
                    <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                            BorderBrush="#e0e0e0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Review Actions" FontSize="14" FontWeight="Bold"
                                       Foreground="#2c3e50" Margin="0,0,0,8"/>

                            <!-- Feedback textbox -->
                            <TextBlock Text="Feedback (required for Reject)" FontSize="12" FontWeight="Bold" Foreground="#555"/>
                            <TextBox Text="{Binding Feedback, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="60" Padding="8" Margin="0,4,0,10"
                                     FontSize="13"/>

                            <!-- Action messages -->
                            <TextBlock Text="{Binding ActionErrorMessage}" Foreground="#e74c3c"
                                       TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12"
                                       Visibility="{Binding ActionErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding ActionSuccessMessage}" Foreground="#27ae60"
                                       TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12"
                                       Visibility="{Binding ActionSuccessMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Action buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="✓ Approve"
                                        Command="{Binding ApproveChapterCommand}"
                                        Background="#27ae60" Foreground="White"
                                        BorderThickness="0" Padding="14,8" Margin="0,0,8,0"
                                        FontSize="13" Cursor="Hand"
                                        IsEnabled="{Binding IsSubmittingAction, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}"/>
                                <Button Content="✗ Reject"
                                        Command="{Binding RejectChapterCommand}"
                                        Background="#e67e22" Foreground="White"
                                        BorderThickness="0" Padding="14,8" Margin="0,0,8,0"
                                        FontSize="13" Cursor="Hand"
                                        IsEnabled="{Binding IsSubmittingAction, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}"/>
                                <Button Content="⏸ Hold"
                                        Command="{Binding PutChapterOnHoldCommand}"
                                        Background="#8e44ad" Foreground="White"
                                        BorderThickness="0" Padding="14,8" Margin="0,0,8,0"
                                        FontSize="13" Cursor="Hand"
                                        IsEnabled="{Binding IsSubmittingAction, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}"/>
                                <Button Content="▶ Publish"
                                        Command="{Binding PublishChapterCommand}"
                                        Background="#2980b9" Foreground="White"
                                        BorderThickness="0" Padding="14,8" Margin="0,0,8,0"
                                        FontSize="13" Cursor="Hand"
                                        IsEnabled="{Binding IsSubmittingAction, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}"/>
                            </StackPanel>

                            <!-- Processing indicator -->
                            <TextBlock Text="Processing..." Foreground="#3498db"
                                       FontStyle="Italic" FontSize="12" Margin="0,8,0,0"
                                       Visibility="{Binding IsSubmittingAction, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
