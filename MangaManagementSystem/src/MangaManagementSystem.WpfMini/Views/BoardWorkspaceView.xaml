<UserControl x:Class="MangaManagementSystem.WpfMini.Views.Workspaces.BoardWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="BoardWorkspaceView_OnLoaded"
             d:DesignHeight="650"
             d:DesignWidth="1000">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Keep the existing board sidebar. -->
        <Border Grid.Column="0" Background="#34495e">
            <StackPanel Margin="14">
                <TextBlock Text="EDITORIAL BOARD"
                           Foreground="#95a5a6"
                           FontSize="12"
                           FontWeight="Bold"
                           Margin="0,8,0,18"/>

                <TextBlock Text="Board Polls"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <Button Content="Refresh"
                        Command="{Binding LoadCommand}"
                        Margin="0,0,0,12"/>

                <TextBlock Text="Board Member can vote. Board Chief can also open, close and cancel polls."
                           TextWrapping="Wrap"
                           Foreground="#bdc3c7"
                           FontSize="12"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#ecf0f1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="Editorial Board Workspace"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#2c3e50"/>
                        <TextBlock Text="Loading..."
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#7f8c8d"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </DockPanel>

                    <Border Background="#f8d7da"
                            BorderBrush="#f5c6cb"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#721c24"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Background="#d4edda"
                            BorderBrush="#c3e6cb"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SuccessMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SuccessMessage}"
                                   Foreground="#155724"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- KPI summary -->
                    <UniformGrid Columns="3" Margin="0,0,0,18">
                        <Border Background="White" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Proposals" Foreground="#7f8c8d"/>
                                <TextBlock Text="{Binding ProposalReviewCount}" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="6" Padding="14" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Open Polls" Foreground="#7f8c8d"/>
                                <TextBlock Text="{Binding OpenPollCount}" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="6" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Awaiting Decision" Foreground="#7f8c8d"/>
                                <TextBlock Text="{Binding AwaitingDecisionCount}" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Chief: open poll -->
                    <Border Background="White"
                            CornerRadius="6"
                            Padding="16"
                            Margin="0,0,0,18"
                            Visibility="{Binding IsChief, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="1. Open Serialization Poll"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#2c3e50"
                                       Margin="0,0,0,10"/>

                            <DataGrid ItemsSource="{Binding ReadyProposals}"
                                      SelectedItem="{Binding SelectedProposal}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      Height="150"
                                      Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="110"/>
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="150"/>
                                    <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="150"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Poll reason" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding PollReason, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="58"
                                             Padding="8"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Official frequency" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding PublicationFrequencies}"
                                              SelectedItem="{Binding SelectedPublicationFrequency}"
                                              Height="34"
                                              Margin="0,2,0,10"/>
                                    <Button Content="Open Poll"
                                            Command="{Binding OpenPollCommand}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- All board roles: vote; chief also closes/cancels. -->
                    <Border Background="White" CornerRadius="6" Padding="16" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="2. Vote on Open Poll"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#2c3e50"
                                       Margin="0,0,0,10"/>

                            <DataGrid ItemsSource="{Binding OpenPolls}"
                                      SelectedItem="{Binding SelectedPoll}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      Height="190"
                                      Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Series" Binding="{Binding SeriesTitle}" Width="*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding PollTypeCode}" Width="155"/>
                                    <DataGridTextColumn Header="Approve" Binding="{Binding ApproveVotes}" Width="70"/>
                                    <DataGridTextColumn Header="Reject" Binding="{Binding RejectVotes}" Width="65"/>
                                    <DataGridTextColumn Header="Abstain" Binding="{Binding AbstainVotes}" Width="70"/>
                                    <DataGridTextColumn Header="Your Vote" Binding="{Binding CurrentUserChoiceCode}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Vote reason (required for REJECT)" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding VoteReason, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="42"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Padding="8"
                                     Margin="0,2,0,10"/>

                            <WrapPanel>
                                <Button Content="Approve"
                                        Command="{Binding VoteCommand}"
                                        CommandParameter="APPROVE"
                                        Background="#27ae60"
                                        Margin="0,0,8,8"/>
                                <Button Content="Reject"
                                        Command="{Binding VoteCommand}"
                                        CommandParameter="REJECT"
                                        Background="#e74c3c"
                                        Margin="0,0,8,8"/>
                                <Button Content="Abstain"
                                        Command="{Binding VoteCommand}"
                                        CommandParameter="ABSTAIN"
                                        Background="#7f8c8d"
                                        Margin="0,0,18,8"/>

                                <Button Content="Close / Finalize"
                                        Command="{Binding FinalizePollCommand}"
                                        Background="#8e44ad"
                                        Margin="0,0,8,8"
                                        Visibility="{Binding IsChief, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Content="Cancel Poll"
                                        Command="{Binding CancelPollCommand}"
                                        Background="#c0392b"
                                        Margin="0,0,8,8"
                                        Visibility="{Binding IsChief, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- History -->
                    <Border Background="White" CornerRadius="6" Padding="16">
                        <StackPanel>
                            <TextBlock Text="3. Poll History"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#2c3e50"
                                       Margin="0,0,0,10"/>

                            <DataGrid ItemsSource="{Binding PollHistory}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Height="210">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Series" Binding="{Binding SeriesTitle}" Width="*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding PollStatusCode}" Width="90"/>
                                    <DataGridTextColumn Header="Result" Binding="{Binding ComputedResultCode}" Width="115"/>
                                    <DataGridTextColumn Header="A" Binding="{Binding ApproveVotes}" Width="45"/>
                                    <DataGridTextColumn Header="R" Binding="{Binding RejectVotes}" Width="45"/>
                                    <DataGridTextColumn Header="X" Binding="{Binding AbstainVotes}" Width="45"/>
                                    <DataGridTextColumn Header="Your Vote" Binding="{Binding CurrentUserChoiceCode}" Width="90"/>
                                    <DataGridTextColumn Header="Ended" Binding="{Binding EndsAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="135"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
