<UserControl x:Class="MangaManagementSystem.WpfMini.Views.Workspaces.BoardWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1200"
             Loaded="OnLoaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAVIGATION -->
        <Border Grid.Column="0" Background="#34495E">
            <StackPanel Margin="0,14">
                <TextBlock Text="EDITORIAL BOARD"
                           Foreground="#9FB3C8"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="16,10,16,8"/>

                <RadioButton Content="Proposal Review"
                             IsChecked="{Binding IsOnProposalReview}"
                             Command="{Binding NavigateToProposalReviewCommand}"
                             Visibility="{Binding IsChief, Converter={StaticResource BoolToVisibilityConverter}}"
                             Foreground="White"
                             Padding="16,10"
                             Margin="0,2"
                             Cursor="Hand"/>

                <RadioButton Content="Board Polls"
                             IsChecked="{Binding IsOnBoardPolls}"
                             Command="{Binding NavigateToBoardPollsCommand}"
                             Foreground="White"
                             Padding="16,10"
                             Margin="0,2"
                             Cursor="Hand"/>

                <RadioButton Content="Decision Center"
                             IsChecked="{Binding IsOnDecisionCenter}"
                             Command="{Binding NavigateToDecisionCenterCommand}"
                             Visibility="{Binding IsChief, Converter={StaticResource BoolToVisibilityConverter}}"
                             Foreground="White"
                             Padding="16,10"
                             Margin="0,2"
                             Cursor="Hand"/>

                <RadioButton Content="Poll History"
                             IsChecked="{Binding IsOnHistory}"
                             Command="{Binding NavigateToHistoryCommand}"
                             Foreground="White"
                             Padding="16,10"
                             Margin="0,2"
                             Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Column="1" Background="#F3F6F8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#DDE4EA"
                    BorderThickness="0,0,0,1"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Editorial Board Workspace"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#263746"/>
                        <TextBlock Text="Open polls, cast votes, close decisions and review history."
                                   Foreground="#708090"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Padding="16,8"
                            MinWidth="95"
                            VerticalAlignment="Center"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18">

                <!-- PROPOSAL REVIEW -->
                <Grid Visibility="{Binding IsOnProposalReview, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Proposals ready for board review"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#263746"
                               Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Proposals}"
                              SelectedItem="{Binding SelectedProposal}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Background="White"
                              BorderBrush="#DDE4EA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Series" Binding="{Binding SeriesTitle}" Width="2*"/>
                            <DataGridTextColumn Header="Proposal" Binding="{Binding ProposalTitle}" Width="2*"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding ProposalVersionNo}" Width="80"/>
                            <DataGridTextColumn Header="Submitted by" Binding="{Binding SubmitterDisplayName}" Width="150"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="165"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="#DDE4EA"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="14"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="Poll reason" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding PollReason, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="55"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="Official frequency" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding PublicationFrequencies}"
                                          SelectedItem="{Binding SelectedPublicationFrequency}"
                                          Margin="0,5,0,0"
                                          Height="30"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="Open Poll"
                                    Command="{Binding OpenPollCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                    Padding="18,9"
                                    MinWidth="110"
                                    VerticalAlignment="Bottom"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- BOARD POLLS -->
                <Grid Visibility="{Binding IsOnBoardPolls, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Open board polls"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#263746"
                               Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding OpenPolls}"
                              SelectedItem="{Binding SelectedOpenPoll}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              Background="White"
                              BorderBrush="#DDE4EA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Series" Binding="{Binding SeriesTitle}" Width="2*"/>
                            <DataGridTextColumn Header="Poll" Binding="{Binding PollName}" Width="2*"/>
                            <DataGridTextColumn Header="Approve" Binding="{Binding ApproveVotes}" Width="80"/>
                            <DataGridTextColumn Header="Reject" Binding="{Binding RejectVotes}" Width="80"/>
                            <DataGridTextColumn Header="Abstain" Binding="{Binding AbstainVotes}" Width="80"/>
                            <DataGridTextColumn Header="My vote" Binding="{Binding CurrentUserChoiceCode}" Width="110"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding ComputedResultCode}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="#DDE4EA"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="14"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="Vote reason (required for REJECT)" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding VoteReason, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32"
                                         Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom">
                                <Button Content="Approve"
                                        Command="{Binding CastVoteCommand}"
                                        CommandParameter="APPROVE"
                                        Padding="16,8"
                                        Margin="0,0,8,0"
                                        Cursor="Hand"/>
                                <Button Content="Reject"
                                        Command="{Binding CastVoteCommand}"
                                        CommandParameter="REJECT"
                                        Padding="16,8"
                                        Margin="0,0,8,0"
                                        Cursor="Hand"/>
                                <Button Content="Abstain"
                                        Command="{Binding CastVoteCommand}"
                                        CommandParameter="ABSTAIN"
                                        Padding="16,8"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- DECISION CENTER -->
                <Grid Visibility="{Binding IsOnDecisionCenter, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Decision Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#263746"
                               Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding OpenPolls}"
                              SelectedItem="{Binding SelectedDecisionPoll}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              Background="White"
                              BorderBrush="#DDE4EA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Series" Binding="{Binding SeriesTitle}" Width="2*"/>
                            <DataGridTextColumn Header="Poll" Binding="{Binding PollName}" Width="2*"/>
                            <DataGridTextColumn Header="Approve" Binding="{Binding ApproveVotes}" Width="90"/>
                            <DataGridTextColumn Header="Reject" Binding="{Binding RejectVotes}" Width="90"/>
                            <DataGridTextColumn Header="Abstain" Binding="{Binding AbstainVotes}" Width="90"/>
                            <DataGridTextColumn Header="Computed result" Binding="{Binding ComputedResultCode}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <Button Content="Close Vote"
                                Command="{Binding FinalizePollCommand}"
                                Padding="18,9"
                                Margin="0,0,10,0"
                                Cursor="Hand"/>
                        <Button Content="Cancel Vote"
                                Command="{Binding CancelPollCommand}"
                                Padding="18,9"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- HISTORY -->
                <Grid Visibility="{Binding IsOnHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Poll history"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#263746"
                               Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding PollHistory}"
                              SelectedItem="{Binding SelectedHistoryPoll}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Background="White"
                              BorderBrush="#DDE4EA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Series" Binding="{Binding SeriesTitle}" Width="2*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding PollStatusCode}" Width="110"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding ComputedResultCode}" Width="130"/>
                            <DataGridTextColumn Header="Approve" Binding="{Binding ApproveVotes}" Width="80"/>
                            <DataGridTextColumn Header="Reject" Binding="{Binding RejectVotes}" Width="80"/>
                            <DataGridTextColumn Header="Abstain" Binding="{Binding AbstainVotes}" Width="80"/>
                            <DataGridTextColumn Header="My vote" Binding="{Binding CurrentUserChoiceCode}" Width="110"/>
                            <DataGridTextColumn Header="Ended at" Binding="{Binding EndsAtUtc}" Width="165"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#DDE4EA"
                    BorderThickness="0,1,0,0"
                    Padding="18,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#34495E"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  Loading..."
                               Foreground="#7F8C8D"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
