<UserControl x:Class="MangaManagementSystem.WpfMini.Views.EditorDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900">
    <ScrollViewer>
        <StackPanel Margin="20">

            <!-- ═══ Header + Refresh ═══ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Editor Dashboard" FontSize="24"
                           FontWeight="Bold" Foreground="#2c3e50"/>
                <Button Grid.Column="1" Content="⟳ Refresh" Command="{Binding LoadDashboardCommand}"
                        Background="#3498db" Foreground="White"
                        BorderThickness="0" Padding="12,6" FontSize="13" Cursor="Hand"/>
            </Grid>

            <!-- Loading / Error -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#e74c3c" TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Text="Loading dashboard..." Foreground="#999" FontStyle="Italic"
                       HorizontalAlignment="Center" Margin="0,20"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- ═══ KPI Cards ═══ -->
            <Grid Margin="0,0,0,20" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI: Pending Proposals -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16"
                        BorderBrush="#e0e0e0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding PendingProposalCount}" FontSize="36"
                                   FontWeight="Bold" Foreground="#2980b9"/>
                        <TextBlock Text="Proposals Pending" FontSize="13" Foreground="#7f8c8d" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI: Completed Proposals -->
                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16"
                        BorderBrush="#e0e0e0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding CompletedProposalCount}" FontSize="36"
                                   FontWeight="Bold" Foreground="#27ae60"/>
                        <TextBlock Text="Proposals Done" FontSize="13" Foreground="#7f8c8d" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI: Chapters Under Review -->
                <Border Grid.Column="4" Background="White" CornerRadius="8" Padding="16"
                        BorderBrush="#e0e0e0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding ChaptersUnderReviewCount}" FontSize="36"
                                   FontWeight="Bold" Foreground="#e67e22"/>
                        <TextBlock Text="Chapters Under Review" FontSize="13" Foreground="#7f8c8d" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI: Pending Annotations -->
                <Border Grid.Column="6" Background="White" CornerRadius="8" Padding="16"
                        BorderBrush="#e0e0e0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding PendingAnnotationCount}" FontSize="36"
                                   FontWeight="Bold" Foreground="#e74c3c"/>
                        <TextBlock Text="Open Annotations" FontSize="13" Foreground="#7f8c8d" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI: Serialized Series -->
                <Border Grid.Column="8" Background="White" CornerRadius="8" Padding="16"
                        BorderBrush="#e0e0e0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding SerializedSeriesCount}" FontSize="36"
                                   FontWeight="Bold" Foreground="#8e44ad"/>
                        <TextBlock Text="Serialized Series" FontSize="13" Foreground="#7f8c8d" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════ -->
            <!-- Section A: Unclaimed Proposals                   -->
            <!-- ════════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                    BorderBrush="#e0e0e0" BorderThickness="1"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}">
                <StackPanel>
                    <TextBlock Text="Proposals Awaiting Review" FontSize="16" FontWeight="Bold"
                               Foreground="#2c3e50" Margin="0,0,0,4"/>
                    <TextBlock Text="Claim a proposal to begin your editorial review."
                               FontSize="12" Foreground="#7f8c8d" Margin="0,0,0,12"/>

                    <!-- Claim success/error messages -->
                    <TextBlock Text="{Binding ClaimSuccessMessage}" Foreground="#27ae60"
                               TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12"
                               Visibility="{Binding ClaimSuccessMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding ClaimErrorMessage}" Foreground="#e74c3c"
                               TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12"
                               Visibility="{Binding ClaimErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <ItemsControl ItemsSource="{Binding UnclaimedProposals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#f9f9f9" CornerRadius="6" Padding="12"
                                        BorderBrush="#eee" BorderThickness="1" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SeriesTitle}" FontWeight="Bold"
                                                           FontSize="14" Foreground="#2c3e50"/>
                                                <TextBlock Text="{Binding ProposalVersionNo, StringFormat=' v{0}'}"
                                                           FontSize="12" Foreground="#7f8c8d" VerticalAlignment="Center"
                                                           Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ProposalTitle}" FontSize="12"
                                                       Foreground="#555" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding SubmitterDisplayName}"
                                                           FontSize="11" Foreground="#888"/>
                                                <TextBlock Text="{Binding SubmittedAtDisplay, StringFormat=' · {0}'}"
                                                           FontSize="11" Foreground="#95a5a6" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Claim"
                                                Command="{Binding DataContext.ClaimProposalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#2980b9" Foreground="White"
                                                BorderThickness="0" Padding="16,8" FontSize="13"
                                                VerticalAlignment="Center" Cursor="Hand"
                                                IsEnabled="{Binding DataContext.IsClaiming, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <Border Background="#f0f7ff" CornerRadius="6" Padding="16"
                            BorderBrush="#d5e8f7" BorderThickness="1"
                            Visibility="{Binding HasNoUnclaimedProposals, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="All proposals have been claimed. Check back later!"
                                   Foreground="#2980b9" FontSize="13" TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════ -->
            <!-- Section B: My Claimed Proposals                  -->
            <!-- ════════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="8" Padding="16"
                    BorderBrush="#e0e0e0" BorderThickness="1"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}">
                <StackPanel>
                    <TextBlock Text="My Claimed Proposals" FontSize="16" FontWeight="Bold"
                               Foreground="#2c3e50" Margin="0,0,0,4"/>
                    <TextBlock Text="Click a proposal to open the review screen."
                               FontSize="12" Foreground="#7f8c8d" Margin="0,0,0,12"/>

                    <ItemsControl ItemsSource="{Binding MyClaimedProposals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#f0faf0" CornerRadius="6" Padding="12"
                                        BorderBrush="#d5f5e3" BorderThickness="1" Margin="0,0,0,8"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.OpenClaimedProposalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SeriesTitle}" FontWeight="Bold"
                                                           FontSize="14" Foreground="#2c3e50"/>
                                                <TextBlock Text="{Binding ProposalVersionNo, StringFormat=' v{0}'}"
                                                           FontSize="12" Foreground="#7f8c8d" VerticalAlignment="Center"
                                                           Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ProposalTitle}" FontSize="12"
                                                       Foreground="#555" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding SubmitterDisplayName}"
                                                           FontSize="11" Foreground="#888"/>
                                                <TextBlock Text="{Binding SubmittedAtDisplay, StringFormat=' · {0}'}"
                                                           FontSize="11" Foreground="#95a5a6" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="→ Review"
                                                   Foreground="#27ae60" FontWeight="Bold"
                                                   FontSize="13" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <Border Background="#f9f9f9" CornerRadius="6" Padding="16"
                            BorderBrush="#eee" BorderThickness="1"
                            Visibility="{Binding HasNoMyClaimedProposals, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="You haven't claimed any proposals yet."
                                   Foreground="#888" FontSize="13" TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════ -->
            <!-- Section C: Recent Series Activity                -->
            <!-- ════════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,16,0,0"
                    BorderBrush="#e0e0e0" BorderThickness="1"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}">
                <StackPanel>
                    <TextBlock Text="Recent Series Activity" FontSize="16" FontWeight="Bold"
                               Foreground="#2c3e50" Margin="0,0,0,12"/>

                    <ItemsControl ItemsSource="{Binding RecentSeriesActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#f9f9f9" CornerRadius="6" Padding="12"
                                        BorderBrush="#eee" BorderThickness="1" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SeriesTitle}" FontWeight="Bold"
                                                           FontSize="14" Foreground="#2c3e50"/>
                                                <TextBlock Text="{Binding SeriesSlug, StringFormat=' /{0}'}"
                                                           FontSize="12" Foreground="#7f8c8d" VerticalAlignment="Center"
                                                           Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="{Binding StatusCode, Converter={StaticResource StatusToBrushConverter}}"
                                                        CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding StatusCode}" Foreground="White"
                                                               FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding LatestChapterLabel, StringFormat=' · {0}'}"
                                                           FontSize="11" Foreground="#95a5a6" Margin="6,0,0,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding LastActivityDisplay, StringFormat=' · {0}'}"
                                                           FontSize="11" Foreground="#95a5a6" Margin="4,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <Border Background="#f9f9f9" CornerRadius="6" Padding="16"
                            BorderBrush="#eee" BorderThickness="1"
                            Visibility="{Binding HasNoSeriesActivity, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="No recent series activity."
                                   Foreground="#888" FontSize="13" TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
