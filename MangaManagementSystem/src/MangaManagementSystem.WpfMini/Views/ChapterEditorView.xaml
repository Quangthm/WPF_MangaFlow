<UserControl x:Class="MangaManagementSystem.WpfMini.Views.ChapterEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1050">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#2c3e50"/>
                <TextBlock Text="{Binding SeriesTitle}"
                           Margin="0,4,0,0"
                           Foreground="#7f8c8d"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SeriesTitle}"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Back to Chapters"
                    Command="{Binding BackCommand}"
                    Padding="15,7"
                    VerticalAlignment="Top"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,15">
                <TextBlock Text="Working..."
                           Foreground="#2980b9"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#c0392b"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding SuccessMessage}"
                           Foreground="#27ae60"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <GroupBox Header="Chapter Metadata" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Series" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SeriesTitle}"
                                 IsReadOnly="True"
                                 Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1"
                                   Text="Chapter number *"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,10"/>
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding ChapterNumberLabel, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="20"
                                 IsReadOnly="{Binding CanEditMetadata, Converter={StaticResource InverseBoolConverter}}"
                                 Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2"
                                   Text="Chapter title"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,10"/>
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding ChapterTitle, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200"
                                 IsReadOnly="{Binding CanEditMetadata, Converter={StaticResource InverseBoolConverter}}"
                                 Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="3" Text="Status" VerticalAlignment="Center"/>
                        <Border Grid.Row="3"
                                Grid.Column="1"
                                Background="{Binding StatusCode, Converter={StaticResource StatusToBrushConverter}}"
                                CornerRadius="4"
                                Padding="8,3"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StatusCode}"
                                       Foreground="White"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Dates and Scheduling" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Created" VerticalAlignment="Center" Margin="0,0,8,10"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CreatedAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                   Margin="0,0,15,10"/>
                        <TextBlock Grid.Column="2" Text="Last updated" VerticalAlignment="Center" Margin="0,0,8,10"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding UpdatedAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                   Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Text="Planned release" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker Grid.Row="1"
                                    Grid.Column="1"
                                    SelectedDate="{Binding PlannedReleaseDate}"
                                    IsEnabled="{Binding CanSchedule}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Released" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   Text="{Binding ReleasedAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Latest Editorial Review" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <TextBlock Text="No editorial review is available for this chapter."
                                   Foreground="#7f8c8d"
                                   Visibility="{Binding HasNoLatestReview, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <StackPanel Visibility="{Binding HasLatestReview, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding LatestReview.ReviewerDisplayName, StringFormat='Reviewer: {0}'}"/>
                            <TextBlock Text="{Binding LatestReview.DecisionCode, StringFormat='Decision: {0}'}"
                                       Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding LatestReview.ReviewedAtUtc, StringFormat='Reviewed: {0:dd/MM/yyyy HH:mm}'}"
                                       Margin="0,5,0,0"/>
                            <TextBlock Text="Comments" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding LatestReview.Comments}"
                                       TextWrapping="Wrap"
                                       MaxHeight="180"
                                       ToolTip="{Binding LatestReview.Comments}"/>
                            <Button Content="Open markup"
                                    Command="{Binding OpenMarkupUrlCommand}"
                                    IsEnabled="{Binding CanOpenMarkupUrl}"
                                    HorizontalAlignment="Left"
                                    Padding="12,6"
                                    Margin="0,10,0,0"
                                    ToolTip="{Binding LatestReview.MarkupFileUrl}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Pages and Versions"
                          Padding="14"
                          MinHeight="560">
                    <ContentControl Content="{Binding PageWorkspace}"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="#dcdde1"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding SaveButtonText}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        Padding="15,7"
                        Margin="0,0,8,0"/>
                <Button Content="Submit for Review"
                        Command="{Binding SubmitCommand}"
                        IsEnabled="{Binding CanSubmit}"
                        Padding="15,7"
                        Margin="0,0,8,0"/>
                <Button Content="Schedule"
                        Command="{Binding ScheduleCommand}"
                        IsEnabled="{Binding CanSchedule}"
                        Padding="15,7"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
