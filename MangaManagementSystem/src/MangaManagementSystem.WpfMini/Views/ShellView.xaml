<UserControl x:Class="MangaManagementSystem.WpfMini.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="900">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Shared application header -->

        <Border Grid.Row="0"
                Background="#2c3e50"
                Padding="15,10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">

                    <TextBlock Text="MangaFlow"
                               FontWeight="Bold"
                               Foreground="White"
                               FontSize="18"
                               VerticalAlignment="Center"/>

                    <Rectangle Width="1"
                               Fill="#34495e"
                               Margin="12,4"/>

                    <TextBlock Text="{Binding Session.DisplayName}"
                               FontWeight="Bold"
                               Foreground="White"
                               FontSize="16"
                               VerticalAlignment="Center"/>

                    <Border Background="#34495e"
                            CornerRadius="4"
                            Padding="8,2"
                            Margin="8,0">

                        <TextBlock Text="{Binding Session.RoleCode}"
                                   Foreground="#95a5a6"
                                   FontSize="12"/>

                    </Border>

                </StackPanel>

                <Border Grid.Column="1"
                        CornerRadius="4"
                        Background="#e74c3c">

                    <Button Content="Logout"
                            Command="{Binding LogoutCommand}"
                            Foreground="White"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,6"
                            Cursor="Hand"/>

                </Border>

            </Grid>

        </Border>


        <!-- Role-specific workspace -->

        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentWorkspaceViewModel}"/>

    </Grid>

</UserControl>