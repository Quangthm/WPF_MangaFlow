<UserControl x:Class="MangaManagementSystem.WpfMini.Views.EditorProposalReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="960">
    <Grid Background="#ecf0f1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Proposal Review Queue"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="#2c3e50"/>

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="5"
                    Padding="7"
                    Margin="0,6,0,6"
                    BorderBrush="#ddd"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Filter"
                               VerticalAlignment="Center"
                               Foreground="#666"
                               FontSize="12"
                               Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1"
                              SelectedValue="{Binding StatusFilter}"
                              FontSize="12"
                              Height="28">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="Under Editorial Review"/>
                        <ComboBoxItem Content="Under Board Review"/>
                        <ComboBoxItem Content="Revision Requested"/>
                    </ComboBox>
                    <Button Grid.Column="2"
                            Content="Reload"
                            Command="{Binding LoadQueueCommand}"
                            Padding="9,4"
                            Margin="6,0,0,0"
                            FontSize="12"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="Loading queue..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#777"
                       Visibility="{Binding IsQueueLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding ProposalQueue}"
                     SelectedItem="{Binding SelectedProposal}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent"
                     BorderThickness="0"
                     Visibility="{Binding IsQueueLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}">
                <ListBox.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="5"
                                            Padding="0"
                                            BorderThickness="0">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#d5e8f7"/>
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#3498db"/>
                                            <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#ebf5fb"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Resources>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                CornerRadius="5"
                                Padding="10"
                                BorderBrush="#e5e5e5"
                                BorderThickness="1">
                            <StackPanel>
                                <Border Background="{Binding StatusCode, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,5">
                                    <TextBlock Text="{Binding StatusDisplay}"
                                               Foreground="White"
                                               FontSize="10"
                                               FontWeight="Bold"/>
                                </Border>

                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding ProposalVersionNo, StringFormat='v{0}'}"
                                               FontSize="12"
                                               Foreground="#7f8c8d"
                                               Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding SeriesTitle}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="#2c3e50"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <TextBlock FontSize="12"
                                           Foreground="#7f8c8d"
                                           Margin="0,2,0,0">
                                    <Run Text="by "/>
                                    <Run Text="{Binding SubmitterDisplayName}" FontWeight="SemiBold"/>
                                </TextBlock>

                                <TextBlock Text="{Binding ProposalFileName}"
                                           FontSize="11"
                                           Foreground="#95a5a6"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Rectangle Grid.Column="1" Fill="#d7dde1"/>

        <Grid Grid.Column="2" Margin="8">
            <TextBlock Text="Select a proposal from the queue to review"
                       Foreground="#95a5a6"
                       FontSize="15"
                       FontStyle="Italic"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}"/>

            <TextBlock Text="Loading detail..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#777"
                       Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <ScrollViewer Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Margin="0,0,8,8">
                    <Border Background="White"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,8"
                            BorderBrush="#e0e0e0"
                            BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right"
                                        Background="{Binding SelectedDetail.ProposalStatusCode, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="4"
                                        Padding="8,3"
                                        Margin="10,0,0,0">
                                    <TextBlock Text="{Binding SelectedDetail.StatusDisplay}"
                                               Foreground="White"
                                               FontSize="11"
                                               FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedDetail.SeriesTitle}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#2c3e50"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>

                            <TextBlock Text="{Binding SelectedDetail.SeriesSlug, StringFormat='/{0}'}"
                                       Foreground="#7f8c8d"
                                       FontSize="12"
                                       Margin="0,1,0,0"/>

                            <ItemsControl ItemsSource="{Binding SelectedDetail.Genres}" Margin="0,7,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#e8f4fd"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                Margin="0,0,5,4">
                                            <TextBlock Text="{Binding GenreName}"
                                                       FontSize="12"
                                                       Foreground="#2980b9"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding SelectedDetail.Tags}" Margin="0,1,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#f0f0f0"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                Margin="0,0,5,4">
                                            <TextBlock Text="{Binding TagName}"
                                                       FontSize="11"
                                                       Foreground="#666"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,8"
                            BorderBrush="#e0e0e0"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDetail.ProposalTitle, StringFormat='Proposal: {0}'}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#2c3e50"/>
                            <TextBlock Text="{Binding SelectedDetail.ProposalVersionNo, StringFormat='Version {0}'}"
                                       FontSize="12"
                                       Foreground="#7f8c8d"
                                       Margin="0,1,0,0"/>

                            <TextBlock Text="Synopsis"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#555"
                                       Margin="0,8,0,3"/>
                            <Border Background="#f9f9f9"
                                    CornerRadius="5"
                                    Padding="9">
                                <TextBlock Text="{Binding SelectedDetail.SynopsisSnapshot}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="#444"
                                           MaxHeight="90"/>
                            </Border>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Submitted by:" FontSize="12" Foreground="#888"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDetail.SubmitterDisplayName}"
                                           FontSize="12" Foreground="#333" Margin="4,0,16,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Date:" FontSize="12" Foreground="#888"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedDetail.SubmittedAtDisplay}"
                                           FontSize="12" Foreground="#333" Margin="4,0,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Proposal file:" FontSize="12" Foreground="#888" Margin="0,5,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDetail.ProposalFileName}"
                                           FontSize="12" Foreground="#2980b9" Margin="4,5,0,0"
                                           TextDecorations="Underline" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,8"
                            BorderBrush="#e0e0e0"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Editor Action"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#2c3e50"
                                       Margin="0,0,0,7"/>
                            <WrapPanel>
                                <RadioButton Content="Request Revision"
                                             IsChecked="{Binding IsRevisionMode}"
                                             Command="{Binding SetRevisionModeCommand}"
                                             Margin="0,0,12,4"
                                             FontSize="13"
                                             Cursor="Hand"
                                             IsEnabled="{Binding SelectedDetail.CanRequestRevision}"/>
                                <RadioButton Content="Pass to Board"
                                             IsChecked="{Binding IsPassToBoardMode}"
                                             Command="{Binding SetPassToBoardModeCommand}"
                                             Margin="0,0,12,4"
                                             FontSize="13"
                                             Cursor="Hand"
                                             IsEnabled="{Binding SelectedDetail.CanPassToBoard}"/>
                                <RadioButton Content="Cancel Series"
                                             IsChecked="{Binding IsCancelMode}"
                                             Command="{Binding SetCancelModeCommand}"
                                             FontSize="13"
                                             Cursor="Hand"
                                             IsEnabled="{Binding SelectedDetail.CanCancel}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,8"
                            BorderBrush="#e0e0e0"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Comments"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#555"/>
                            <TextBox Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="64"
                                     Padding="7"
                                     Margin="0,3,0,8"
                                     FontSize="13"/>

                            <TextBlock Text="Markup File"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#555"/>
                            <TextBlock Text="Required for Cancel, optional for Revision / Pass to Board"
                                       FontSize="11"
                                       Foreground="#888"
                                       Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding MarkupFileName}"
                                         IsReadOnly="True"
                                         Padding="7"
                                         Foreground="#666"
                                         FontSize="13"/>
                                <Button Grid.Column="1"
                                        Content="Browse"
                                        Command="{Binding BrowseMarkupFileCommand}"
                                        Padding="10,5"
                                        Margin="6,0"/>
                                <Button Grid.Column="2"
                                        Content="Clear"
                                        Command="{Binding ClearMarkupFileCommand}"
                                        Background="#95a5a6"
                                        Padding="10,5"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Request Revision"
                                        Command="{Binding SubmitRevisionCommand}"
                                        Background="#e67e22"
                                        Padding="12,6"
                                        Margin="0,0,7,0"
                                        Visibility="{Binding IsRevisionMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                        IsEnabled="{Binding IsSubmittingAction, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}"/>
                                <Button Content="Pass to Board"
                                        Command="{Binding SubmitPassToBoardCommand}"
                                        Background="#2980b9"
                                        Padding="12,6"
                                        Margin="0,0,7,0"
                                        Visibility="{Binding IsPassToBoardMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                        IsEnabled="{Binding IsSubmittingAction, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}"/>
                                <Button Content="Cancel Series"
                                        Command="{Binding SubmitCancelCommand}"
                                        Background="#e74c3c"
                                        Padding="12,6"
                                        Margin="0,0,7,0"
                                        Visibility="{Binding IsCancelMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                        IsEnabled="{Binding IsSubmittingAction, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}"/>
                            </StackPanel>

                            <TextBlock Text="Processing..."
                                       Foreground="#3498db"
                                       FontStyle="Italic"
                                       FontSize="12"
                                       Margin="0,7,0,0"
                                       Visibility="{Binding IsSubmittingAction, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
