<UserControl x:Class="MangaManagementSystem.WpfMini.Views.ChapterListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Chapters"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#2c3e50"/>
                <TextBlock Text="{Binding SeriesTitle}"
                           Margin="0,4,0,0"
                           FontSize="14"
                           Foreground="#7f8c8d"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SeriesTitle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Back to Series"
                        Command="{Binding BackCommand}"
                        Padding="14,8"
                        Margin="0,0,8,0"/>
                <Button Content="Create Chapter"
                        Command="{Binding CreateChapterCommand}"
                        Padding="14,8"
                        Margin="0,0,8,0"/>
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Padding="14,8"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#dcdde1"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="210"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8"
                         MaxLength="200"
                         VerticalContentAlignment="Center"
                         ToolTip="Search by chapter number or title"/>
                <TextBlock Grid.Column="1"
                           Text="Status:"
                           Margin="15,0,8,0"
                           VerticalAlignment="Center"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusCode}"
                          Padding="6"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Loading chapters..."
                       Foreground="#2980b9"
                       FontWeight="SemiBold"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#c0392b"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
            <TextBlock Text="This series has no chapters yet."
                       Foreground="#7f8c8d"
                       Margin="0,4,0,0"
                       Visibility="{Binding HasNoChapters, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Text="No chapters match the current search and status filter."
                       Foreground="#7f8c8d"
                       Margin="0,4,0,0"
                       Visibility="{Binding HasNoFilteredResults, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#dcdde1"
                BorderThickness="1"
                CornerRadius="5">
            <DataGrid ItemsSource="{Binding FilteredChapters}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="48"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Chapter"
                                        Binding="{Binding ChapterNumberLabel}"
                                        Width="100"/>
                    <DataGridTemplateColumn Header="Title" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ChapterTitle}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding ChapterTitle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Status" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusCode, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="4"
                                        Padding="7,3"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusCode}"
                                               Foreground="White"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Planned"
                                        Binding="{Binding PlannedReleaseDate, StringFormat={}{0:dd/MM/yyyy}}"
                                        Width="105"/>
                    <DataGridTextColumn Header="Created"
                                        Binding="{Binding CreatedAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                        Width="135"/>
                    <DataGridTextColumn Header="Updated"
                                        Binding="{Binding UpdatedAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                        Width="135"/>
                    <DataGridTextColumn Header="Latest decision"
                                        Binding="{Binding LatestReview.DecisionCode}"
                                        Width="130"/>
                    <DataGridTemplateColumn Header="" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Open"
                                        Padding="8,4"
                                        Command="{Binding DataContext.OpenChapterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="4"
                   Margin="0,10,0,0"
                   Foreground="#7f8c8d"
                   Text="{Binding ResultCount, StringFormat='Showing {0} chapters'}"/>
    </Grid>
</UserControl>
